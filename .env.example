APP_NAME="Fokus Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://www.fokuscloud.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fokuscloud
DB_USERNAME=fokuscloud
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
PLATFORM_SUPPORT_SESSION_MINUTES=30

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="suporte@fokuscloud.com.br"
MAIL_FROM_NAME="${APP_NAME}"

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_PREVIOUS_SECRETS=
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_TEST_PAYER_EMAIL=test@testuser.com
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_TIMEOUT=10
MERCADO_PAGO_WEBHOOK_TOLERANCE=300
MERCADO_PAGO_WEBHOOK_RATE_LIMIT=300
MERCADO_PAGO_SCOPE=

# Use somente no servidor de implantação e execute fokus:provision-superadmin.
FOKUS_INITIAL_SUPERADMIN_NAME=
FOKUS_INITIAL_SUPERADMIN_EMAIL=
FOKUS_INITIAL_SUPERADMIN_PASSWORD=
FOKUS_USAGE_INGESTION_SECRET=
FOKUS_USAGE_INGESTION_PREVIOUS_SECRETS=
FOKUS_GA4_MEASUREMENT_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
