{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "seo:sync": "node tools/sync-seo.mjs",
        "seo:check": "node tools/sync-seo.mjs --check",
        "styles:sync": "node tools/sync-fokus-styles.mjs",
        "styles:cache-bust": "node tools/cache-bust-styles-pages.mjs",
        "predev": "npm run styles:sync",
        "build": "npm run seo:sync && npm run styles:sync && npm run styles:cache-bust && vite build",
        "dev": "vite",
        "tokens:check": "node tools/validate-css-tokens.mjs",
        "backoffice:contract:check": "node tools/check-backoffice-ui-contract.mjs",
        "backoffice:page:new": "node tools/create-backoffice-page.mjs",
        "test:backoffice:visual": "playwright test --config=playwright.backoffice.config.mjs",
        "test:security:homologation": "playwright test --config=playwright.security.config.mjs"
    },
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "fokus-styles": "^2.7.0"
    }
}
